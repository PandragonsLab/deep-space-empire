{
  "name": "dimensional-explorer",
  "version": "0.1.0",
  "description": "An epic text-based explorer/idler game",
  "main": "server.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "dev:client": "node src/server/index.js --client-dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "build": "npm run package",
    "package": "electron-builder",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev:client\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "electron-builder --publish=never",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "keywords": ["game", "idler", "explorer", "text-based"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.1",
    "pg": "^8.11.0",
    "redis": "^4.6.7",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "rate-limiter-flexible": "^2.4.2",
    "winston": "^3.9.0",
    "dotenv": "^16.3.1",
    "joi": "^17.9.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "electron": "^25.2.0",
    "electron-builder": "^24.4.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.43.0",
    "prettier": "^2.8.8"
  },
  "build": {
    "appId": "com.yourname.dimensional-explorer",
    "productName": "Dimensional Explorer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules",
      "!dist"
    ],
    "mac": {
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}